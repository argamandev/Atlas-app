# dependencies
node_modules/

# next.js
.next/
out/

# typescript incremental build cache (regenerated by tsc/next build)
tsconfig.tsbuildinfo

# env files
.env
.env.local
.env.*.local

# secrets & local binaries (never commit)
.mcp.json
bin/

# debug
npm-debug.log*

# live-spike runtime state (bot ids + expired meeting urls)
scripts/.recall-spike-bot.json
scripts/.live-bakeoff.json
scripts/.live-broadcast.json

# large test-fixture source PDFs (keep the extracted .txt the harness reads)
scripts/fixtures/*.pdf

# claude — track the shared harness (settings, hooks, rules, skills); ignore local-only files
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/rules/
!.claude/hooks/
