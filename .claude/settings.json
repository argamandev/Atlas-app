{
  "permissions": {
    "allow": [
      "mcp__recall-ai__list_webhook_endpoints",
      "mcp__recall-ai__search_docs",
      "Bash(npm test)",
      "Bash(npx tsc --noEmit*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(node scripts/live-replay-engine.mjs*)"
    ],
    "deny": [
      "Read(./.env*)",
      "Edit(./.env*)",
      "Edit(./.mcp.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/pre-bash-gate.mjs" }]
      },
      {
        "matcher": "mcp__supabase__execute_sql|mcp__supabase__apply_migration",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/pre-bash-gate.mjs" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/post-edit-verify.mjs" }]
      }
    ]
  }
}
