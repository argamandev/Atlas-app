{
  "permissions": {
    "allow": [
      "mcp__recall-ai__list_webhook_endpoints",
      "mcp__recall-ai__search_docs",
      "Bash(npm test)",
      "Bash(npx tsc --noEmit*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(node scripts/live-replay-engine.mjs*)",
      "Bash(node scripts/append-log.mjs *)"
    ],
    "deny": [
      "Read(./.env*)",
      "Edit(./.env*)",
      "Edit(./.mcp.json)",
      "Edit(./agent-memory/cross-cutting.md)",
      "Write(./agent-memory/cross-cutting.md)",
      "Edit(./agent-memory/ready-queue.md)",
      "Write(./agent-memory/ready-queue.md)",
      "Edit(C:/Users/Sagi/Desktop/Atlas/agent-memory/cross-cutting.md)",
      "Write(C:/Users/Sagi/Desktop/Atlas/agent-memory/cross-cutting.md)",
      "Edit(C:/Users/Sagi/Desktop/Atlas/agent-memory/ready-queue.md)",
      "Write(C:/Users/Sagi/Desktop/Atlas/agent-memory/ready-queue.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/pre-bash-gate.mjs" }]
      },
      {
        "matcher": "mcp__supabase__.*",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/pre-bash-gate.mjs" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/post-edit-verify.mjs" }]
      }
    ]
  }
}
