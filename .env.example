SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
OPENAI_API_KEY=
# Optional: override the GPT model used as the formatting fallback when Gemini is down (default: gpt-4.1)
OPENAI_FORMAT_MODEL=
# IVRIT transcription on RunPod (preferred engine). If either is missing, falls back to OpenAI Whisper.
RUNPOD_API_KEY=
RUNPOD_IVRIT_ENDPOINT_ID=
# Optional: override the IVRIT model (default: ivrit-ai/whisper-large-v3-ct2; falls back to the turbo model, then Whisper)
RUNPOD_IVRIT_MODEL=

# Transcript-quality reviewer account (used by scripts/transcribe-batch.mjs).
# A real low-privilege user that can submit transcripts.
REVIEWER_EMAIL=
REVIEWER_PASSWORD=

# Live transcription (Core 1). Recall.ai bot platform + optional streaming engines
# for the live bake-off (scripts/live-bakeoff.mjs).
RECALL_API_KEY=
RECALL_REGION=us-west-2
GLADIA_API_KEY=
ELEVENLABS_API_KEY=

# Ask Atlas v2 (Anthropic) and transcript/workspace formatting (Gemini).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
